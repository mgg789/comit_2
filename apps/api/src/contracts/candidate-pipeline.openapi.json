  },
  "components": {
    "schemas": {
      "CandidateProfile": {
        "properties": {
          "source_revision": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Source Revision"
          },
          "display_name": {
            "type": "string",
            "maxLength": 300,
            "title": "Display Name",
            "default": ""
          },
          "email": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 320
              },
              {
                "type": "null"
              }
            ],
            "title": "Email"
          },
          "email_verified": {
            "type": "boolean",
            "title": "Email Verified",
            "default": false
          },
          "phone": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "title": "Phone"
          },
          "city": {
            "type": "string",
            "maxLength": 300,
            "title": "City",
            "default": ""
          },
          "salary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/SalaryRange"
              },
              {
                "type": "null"
              }
            ]
          },
          "primary_direction": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "backend",
                  "frontend",
                  "fullstack",
                  "mobile",
                  "devops",
                  "data",
                  "qa"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Primary Direction"
          },
          "grade_result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GradeResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "consents": {
            "$ref": "#/components/schemas/Consent"
          },
          "domains": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Domains"
          },
          "stacks": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Stacks"
          },
          "soft_skills": {
            "items": {
              "$ref": "#/components/schemas/Skill"
            },
            "type": "array",
            "maxItems": 1000,
            "title": "Soft Skills"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description",
            "default": ""
          },
          "projects": {
            "items": {
              "$ref": "#/components/schemas/NarrativeClaim"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Projects"
          },
          "experience": {
            "items": {
              "$ref": "#/components/schemas/NarrativeClaim"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Experience"
          },
          "achievements": {
            "items": {
              "$ref": "#/components/schemas/NarrativeClaim"
            },
            "type": "array",
            "maxItems": 100,
            "title": "Achievements"
          },
          "preferences": {
            "items": {
              "type": "string",
              "maxLength": 1000,
              "minLength": 1
            },
            "type": "array",
            "maxItems": 100,
            "title": "Preferences"
          },
          "metadata": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Metadata"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_revision"
        ],
        "title": "CandidateProfile",
        "description": "Complete or draft input; contacts remain private until downstream acceptance."
      },
      "CandidateStatus": {
        "properties": {
          "candidate_id": {
            "type": "string",
            "format": "uuid",
            "title": "Candidate Id"
          },
          "profile_revision": {
            "type": "integer",
            "title": "Profile Revision"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "queued",
              "processing",
              "retrying",
              "failed",
              "ready"
            ],
            "title": "State"
          },
          "missing_requirements": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Requirements"
          },
          "category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Category"
              },
              {
                "type": "null"
              }
            ]
          },
          "strict_schema_version": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Strict Schema Version"
          },
          "attempt_count": {
            "type": "integer",
            "title": "Attempt Count",
            "default": 0
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "candidate_id",
          "profile_revision",
          "state",
          "missing_requirements"
        ],
        "title": "CandidateStatus",
        "description": "Pipeline state for one candidate without private input data or error details."
      },
      "Category": {
        "properties": {
          "specialization": {
            "type": "string",
            "enum": [
              "backend",
              "frontend",
              "fullstack",
              "mobile",
              "devops",
              "data",
              "qa"
            ],
            "title": "Specialization"
          },
          "grade": {
            "type": "string",
            "enum": [
              "intern",
              "junior",
              "middle",
              "senior"
            ],
            "title": "Grade"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "specialization",
          "grade"
        ],
        "title": "Category",
        "description": "Deterministic specialization and grade assigned from upstream test results."
      },
      "Consent": {
        "properties": {
          "processing": {
            "type": "boolean",
            "title": "Processing",
            "default": false
          },
          "pool": {
            "type": "boolean",
            "title": "Pool",
            "default": false
          },
          "accepted_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Accepted At"
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Consent",
        "description": "Explicit, versioned consent snapshot supplied by the trusted API."
      },
      "Coordinate": {
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Index"
          },
          "group": {
            "type": "string",
            "enum": [
              "domain",
              "stack",
              "soft_skill"
            ],
            "title": "Group"
          },
          "key": {
            "type": "string",
            "title": "Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "group",
          "key"
        ],
        "title": "Coordinate",
        "description": "An immutable index in the append-only strict vector registry."
      },
      "CoordinateAddition": {
        "properties": {
          "group": {
            "type": "string",
            "enum": [
              "domain",
              "stack",
              "soft_skill"
            ],
            "title": "Group"
          },
          "key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9_-]*$",
            "title": "Key"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "group",
          "key"
        ],
        "title": "CoordinateAddition",
        "description": "Authorized registry extension; old coordinates cannot be reordered."
      },
      "CoordinateEvidence": {
        "properties": {
          "index": {
            "type": "integer",
            "title": "Index"
          },
          "group": {
            "type": "string",
            "enum": [
              "domain",
              "stack",
              "soft_skill"
            ],
            "title": "Group"
          },
          "key": {
            "type": "string",
            "title": "Key"
          },
          "status": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "confirmed",
                  "partial",
                  "self_reported",
                  "pending",
                  "rejected"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Status"
          },
          "level": {
            "type": "integer",
            "title": "Level"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "index",
          "group",
          "key",
          "status",
          "level"
        ],
        "title": "CoordinateEvidence",
        "description": "Status and declared level, without arbitrary private provenance strings."
      },
      "GradeResult": {
        "properties": {
          "grade": {
            "type": "string",
            "enum": [
              "intern",
              "junior",
              "middle",
              "senior"
            ],
            "title": "Grade"
          },
          "status": {
            "type": "string",
            "enum": [
              "approved",
              "pending",
              "rejected"
            ],
            "title": "Status"
          },
          "test_session_id": {
            "type": "string",
            "format": "uuid",
            "title": "Test Session Id"
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Approved At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "grade",
          "status",
          "test_session_id"
        ],
        "title": "GradeResult",
        "description": "Upstream grade-test result; only approved results permit pool membership."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "JsonValue": {},
      "NarrativeClaim": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Title"
          },
          "description": {
            "type": "string",
            "maxLength": 10000,
            "title": "Description",
            "default": ""
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "partial",
              "self_reported",
              "pending",
              "rejected"
            ],
            "title": "Status"
          },
          "details": {
            "additionalProperties": {
              "$ref": "#/components/schemas/JsonValue"
            },
            "type": "object",
            "maxProperties": 100,
            "title": "Details"
          },
