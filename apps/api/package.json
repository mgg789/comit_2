{
  "name": "@comit/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": ["dist", "migrations"],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "start": "node dist/server.js",
    "auth:migrate": "tsx src/auth/migrate.ts",
    "auth:mail-worker": "tsx src/auth/mail-worker.ts"
  },
  "dependencies": {
    "@comit/shared": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.2.0",
    "fastify": "^5.1.0",
    "jose": "^6.2.12",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
