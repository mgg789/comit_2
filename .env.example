# Comit environment (copy to .env — never commit .env)
# All values are local dev defaults; production values live on the server only.

# Postgres (compose dev publishes host port 5433 to avoid clashes)
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5433

# HTTP ports on the host
WEB_PORT=8088
API_PORT=8080
MATCHING_PORT=8101
TESTING_PORT=8102
INTEGRATION_PORT=8103

# api-core
JWT_SECRET=
# Use AUTH_SECRET (or existing JWT_SECRET) with at least 32 random bytes.
AUTH_SECRET=
AUTH_ALLOWED_ORIGINS=http://localhost:8088
# false only for loopback HTTP development; production requires true/HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_KEY_ID=v1
ACCOUNT_CONSENT_VERSION=account-v1
# Explicit trusted proxy IPs/CIDRs only; empty means forwarding headers are ignored.
TRUST_PROXY=

# Reuse the existing LCT SMTP server. Never provision/change it from this project.
SMTP_HOST=mail.droidje.com
SMTP_PORT=587
SMTP_TLS_SERVERNAME=mail.droidje.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Comit <noreply@mail.droidje.com>
