# Production configuration. Copy to .env and supply private values; never commit .env.
# Use `make dev-up` for isolated local development without this production env file.
POSTGRES_PASSWORD=
WEB_PORT=8088
API_PORT=28080
MATCHING_PORT=28101
AGENTS_PORT=28104
VERIFICATION_PORT=28105
TESTING_PORT=8102
# Optional consent-gated test media collection; off stores only aggregates.
TESTING_RECORDING_MODE=off
INTEGRATION_PORT=8103
AUTH_SECRET=
JWT_SECRET=
AUTH_ALLOWED_ORIGINS=https://comit.example.org
PUBLIC_SITE_URL=https://comit.example.org
AUTH_KEY_ID=v1
ACCOUNT_CONSENT_VERSION=account-v1
# Explicit trusted nginx/proxy CIDRs. Forwarded headers ignored outside this set.
TRUST_PROXY=
CANDIDATE_PIPELINE_TOKEN=
AGENTS_SERVICE_TOKEN=
VERIFICATION_ENGINE_TOKEN=
# Base64 32-byte encryption key for stored proof documents.
VERIFICATION_DOCUMENT_KEY=
TESTING_ENGINE_TOKEN=
CHAT_SERVICE_TOKEN=
CHAT_DEVICE_SECRET=
CHAT_SIGNING_KEY=
QGRAMM_MANAGEMENT_SECRET=
QGRAMM_MASTER_KEY=
QGRAMM_HPKE_KEY=
# Reuse the existing Navix host SMTP relay; no new SMTP server is provisioned.
SMTP_HOST=host.docker.internal
SMTP_PORT=2525
SMTP_TLS_SERVERNAME=mail.droidje.com
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Comit <noreply@mail.droidje.com>
# Optional Laya/KEV providers degrade explicitly when unconfigured; DeepSeek is required.
# Laya endpoint must be reachable from containers; no bundled host runtime.
JEV_LOCAL_URL=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
JEV_API_URL=https://ai.sverk.tech/v1/systemone
JEV_MODEL=kev-latest
JEV_API_KEY=
AGENT_INPUT_USD_PER_MILLION=0.2
AGENT_OUTPUT_USD_PER_MILLION=0.7
AGENT_CACHED_INPUT_USD_PER_MILLION=0.2
JEV_INPUT_USD_PER_MILLION=0.042
JEV_OUTPUT_USD_PER_MILLION=0
# Support console operator. Both unset = console disabled; partial = startup warning.
# ACCESS_KEY must be a long random secret (>=16 chars), never reused elsewhere.
SUPPORT_EMAIL=
SUPPORT_ACCESS_KEY=
# Optional real HH verification. Missing provider credentials produce explicit unavailability.
HH_API_TOKEN=
HH_USER_AGENT=comit-verification/0.1

# Bounded FSP/weekly promotion. Prod defaults to shadow, explicit dev to active.
# MATCHING_PROMOTION_MODE=shadow
# MATCHING_PROMOTION_ALLOW_DEMO=false

# Real code tests require a dedicated disposable judge VM (docs/deploy.md).
# Mandatory for the dev Compose; never mount the application host Docker socket.
CODE_JUDGE_URL=
CODE_JUDGE_TOKEN=
# Optional private judge CA certificate, PEM with literal \n line separators.
CODE_JUDGE_CA_PEM=
JEV_MODEL=kev-latest
