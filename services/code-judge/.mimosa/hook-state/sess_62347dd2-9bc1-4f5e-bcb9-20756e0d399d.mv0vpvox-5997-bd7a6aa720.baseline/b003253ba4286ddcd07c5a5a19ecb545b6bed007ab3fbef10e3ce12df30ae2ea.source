"""DMOJ judge-server bridge: problem packaging now, live judging next pass.

The DMOJ judge-server (github.com/DMOJ/judge-server) consumes problem
directories (init.yml + tests) and returns per-case verdicts over its site
protocol (ZMQ). This module provides the storage half today: packaging a bank
item into a DMOJ problem folder (problem.yaml, tests in/<case>.in, out/<case>.out),
plus a deliberately disabled bridge stub - enabling live judging is an
operator decision with the judge daemon deployed (env DMOJ_JUDGE_ADDRESS).
"""

from __future__ import annotations

import json
from pathlib import Path

SUPPORTED_LANGUAGES = ("python",)


def package_problem(item_id: str, payload: dict, out_dir: Path) -> Path:
    """Write one bank code item as a DMOJ problem folder; returns the folder.

    Expected payload: {function_name, tests: [{args, expected}]} - the
    generated harness calls the candidate function with named arguments and
    compares JSON-serialized results, so each case's output file carries the
    expected JSON list of booleans per test.
    """
    function_name = str(payload.get("function_name", ""))
    tests = payload.get("tests", [])
    if not function_name or not tests:
        raise ValueError("code item lacks function_name or tests")
    problem_dir = out_dir / item_id
    (problem_dir / "tests").mkdir(parents=True, exist_ok=True)
    init = {
        "name": item_id,
        "group": "comit",
        "validator": "standard",
        "languages": ["PY3"],
        "time_limit": 10.0,
        "memory_limit": 256 * 1024,
        "harness": {"function_name": function_name},
    }
    (problem_dir / "init.yml").write_text(
        json.dumps(init, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
    for index, test in enumerate(tests, 1):
        case_input = json.dumps({"kwargs": {f"arg{i}": value for i, value in enumerate(test.get("args", []))},
                                 "function": function_name}, ensure_ascii=False)
        case_output = json.dumps([bool(test.get("expected"))], ensure_ascii=False)
        (problem_dir / "tests" / f"{index:02d}.in").write_text(case_input + "\n", encoding="utf-8")
        (problem_dir / "tests" / f"{index:02d}.out").write_text(case_output + "\n", encoding="utf-8")
    return problem_dir


class DmojBridge:
    """Live judge-server connection stub; deliberately disabled until deployed."""

    def __init__(self, address: str | None = None) -> None:
        self.address = address or os.environ.get("DMOJ_JUDGE_ADDRESS", "")

    def enabled(self) -> bool:
        return bool(self.address)

    def judge(self, problem_dir: Path, code: str, language: str) -> dict:
        raise NotImplementedError(
            "live DMOJ judging is intentionally not enabled; deploy judge-server "
            "and set DMOJ_JUDGE_ADDRESS, then implement the MJOLLNIR handshake "
            "(see docs/testing-design.md, integration pass)")


def load_submission_payload(path: Path) -> dict:
    """Read a submission record for tooling; keeps the storage format in one place."""
    return json.loads(path.read_text(encoding="utf-8"))
